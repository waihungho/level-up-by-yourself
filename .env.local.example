NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Solana RPC — Helius (account: solanagamedev@gmail.com)
# mainnet: https://mainnet.helius-rpc.com/?api-key=<YOUR_API_KEY>
# devnet:  https://devnet.helius-rpc.com/?api-key=<YOUR_API_KEY>
NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Treasury wallet for SOL payments
NEXT_PUBLIC_TREASURY_WALLET=YOUR_TREASURY_WALLET_ADDRESS

# App domain
NEXT_PUBLIC_APP_URL=https://level-up-by-yourself.vercel.app

# Server-only (never prefix with NEXT_PUBLIC_). Required for tactical battles, squads and raids.
SUPABASE_SERVICE_ROLE_KEY=

# Agent NFT minting (server-only secret; see scripts/create-nft-collection.mjs)
NFT_MINT_AUTHORITY_SECRET=
NEXT_PUBLIC_NFT_COLLECTION_ADDRESS=
# Optional: server RPC for minting (falls back to NEXT_PUBLIC_SOLANA_RPC_URL); Irys node override
SOLANA_RPC_URL=
IRYS_ADDRESS=
